# Arch Linux package, built from a release tag: makepkg -si
pkgname=ytmcross
pkgver=0.2.0
pkgrel=1
pkgdesc='A minimal, fast, native YouTube Music client'
arch=('x86_64')
url='https://github.com/craftyderpysmall/ytmcross'
license=('MIT')
depends=('alsa-lib' 'dbus' 'fontconfig' 'wayland' 'libxkbcommon' 'xdg-utils')
makedepends=('cargo')
options=('!lto' '!debug')  # GCC LTO objects from QuickJS don't link with Rust's linker (Rust LTO is in Cargo.toml); no debug info to split
optdepends=('google-chrome: sign-in'
            'chromium: sign-in'
            'noto-fonts-cjk: Chinese, Japanese and Korean titles')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/ytmcross -t "$pkgdir/usr/bin"
    install -Dm644 assets/ytmcross.desktop -t "$pkgdir/usr/share/applications"
    install -Dm644 assets/ytmcross.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
